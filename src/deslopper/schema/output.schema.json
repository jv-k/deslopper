{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deslopper json output",
  "type": "object",
  "required": ["findings", "unreadable", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "col", "tier", "name", "message"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "col": { "type": "integer", "minimum": 1 },
          "tier": { "enum": ["error", "warn"] },
          "name": { "type": "string" },
          "message": { "type": "string" },
          "verdict": { "enum": ["keep", "rewrite"] },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "unreadable": { "type": "array", "items": { "type": "string" } },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "unreadable"],
      "properties": {
        "errors": { "type": "integer" },
        "warnings": { "type": "integer" },
        "unreadable": { "type": "integer" }
      }
    },
    "jev": {
      "description": "Present only when the run used --jev.",
      "type": "object",
      "required": ["keep", "rewrite", "cached", "tokens", "cost", "errors"],
      "properties": {
        "keep": { "type": "integer" },
        "rewrite": { "type": "integer" },
        "cached": { "type": "integer", "description": "How many verdicts came from the local cache, not a new request." },
        "tokens": { "type": "integer" },
        "cost": { "type": "string", "description": "The gateway cost in US dollars, as a decimal string." },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "One line per Jev request that failed. Those findings carry no verdict."
        }
      }
    }
  }
}
