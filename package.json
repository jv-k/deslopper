{
  "name": "deslopper",
  "version": "1.7.2",
  "private": true,
  "description": "Dev and release scripts for the deslopper Python package.",
  "scripts": {
    "bootstrap": "python3 -m venv .venv && .venv/bin/pip install -e . pytest pre-commit && .venv/bin/pre-commit install --hook-type pre-commit --hook-type commit-msg",
    "ds": ".venv/bin/deslopper",
    "try": ".venv/bin/deslopper lint --jev tests/fixtures/ai_slop.md || [ $? -eq 1 ]",
    "try:json": ".venv/bin/deslopper lint --jev --format json tests/fixtures/ai_slop.md || [ $? -eq 1 ]",
    "designs": "bash docs/qa/output-designs/try.sh",
    "test": ".venv/bin/pytest -q",
    "lint": ".venv/bin/deslopper lint --strict",
    "gate": ".venv/bin/pre-commit run --all-files",
    "tells:readme": ".venv/bin/python scripts/readme_tells.py",
    "skill:check": "bash scripts/check-skill-discovery.sh",
    "preflight": "bash scripts/preflight.sh",
    "bump-release": "verbump -c -p origin --release",
    "screenshots": "bash scripts/screenshots.sh",
    "screenshots:help": "bash scripts/screenshots.sh help",
    "screenshots:demo": "bash scripts/screenshots.sh demo"
  },
  "devDependencies": {
    "@jv-k/verbump": "^4.0.3"
  }
}
